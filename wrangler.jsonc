{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adrianclarkedev",
  "compatibility_date": "2026-04-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "adrianclarke.dev/*",
      "zone_name": "adrianclarke.dev"
    },
    {
      "pattern": "www.adrianclarke.dev/*",
      "zone_name": "adrianclarke.dev"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
